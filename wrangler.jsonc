{
  "name": "humanwardlabs",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "humanwardlabs.com", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "404-page" },
  "send_email": [{ "name": "CONTACT", "destination_address": "mike.benjam@gmail.com" }],
  "vars": { "CONTACT_TO": "mike.benjam@gmail.com" }
}
